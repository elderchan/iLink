#!/usr/bin/env bash
set -euo pipefail

# ilink-lightme [-target pm|design] <story> - Pre-check for /ilink-lightme (v1.8.0)
# Validates target document exists, computes Upstream_SHA1, reports domain coverage.
# 不再做状态检查或弹出确认对话——lightme 不限目标文档状态(见 Root Spec §4.8.3)。

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$DIR/_common.sh"

target="design"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -target|--target)
      if [[ $# -lt 2 ]]; then
        echo "❌ 用法：/ilink-lightme [-target pm|design] <story-id>" >&2
        exit 2
      fi
      target="$2"
      if [[ "$target" != "pm" && "$target" != "design" ]]; then
        log_error "Invalid target: $target (must be pm or design)"
        exit 2
      fi
      shift 2
      ;;
    -*)
      log_error "Unknown option: $1"
      echo "❌ 用法：/ilink-lightme [-target pm|design] <story-id>" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -ne 1 || -z "$1" ]]; then
  echo "❌ 用法：/ilink-lightme [-target pm|design] <story-id>" >&2
  if [[ $# -gt 1 ]]; then
    for arg in "$@"; do
      if [[ "$arg" == "-target" || "$arg" == "--target" ]]; then
        echo "   提示：flag 必须在 story-id 之前（如 /ilink-lightme -target pm kcia-1520）" >&2
        break
      fi
    done
  fi
  exit 2
fi

story="$1"
base_dir="$(story_dir "$story")"

if [[ ! -d "$base_dir" ]]; then
  log_error "Story directory not found: $base_dir"
  exit 1
fi

if [[ "$target" == "pm" ]]; then
  target_doc="$base_dir/${story}-pm.master.md"
  target_label="pm"
  missing_msg="pm.master.md not found: $target_doc"
  missing_hint="Run /ilink-pm $story first."
else
  target_doc="$base_dir/${story}-design.master.md"
  target_label="design"
  missing_msg="design.master.md not found: $target_doc"
  missing_hint="Run /ilink-design $story first."
fi

if [[ ! -f "$target_doc" ]]; then
  log_error "$missing_msg"
  echo "  $missing_hint"
  exit 1
fi

status=$(check_status "$target_doc")

# 状态仅作为信息性展示输出,不阻断、不警告。
# lightme 不限目标文档状态——任何状态下拷问对话和报告写入行为完全一致。
# 参见 Root Spec §4.8.3。

sha1=$(shasum "$target_doc" | awk '{print $1}')

domain_dir="iLink-doc/domain"
domain_count=0
if [[ -d "$domain_dir" ]]; then
  domain_count=$(find "$domain_dir" -maxdepth 1 -name '*-domain-knowledge.md' 2>/dev/null | wc -l | tr -d ' ')
fi

target_flag=""
if [[ "$target" != "design" ]]; then
  target_flag=" -target $target"
fi

echo ""
echo "=========================================="
echo "/ilink-lightme${target_flag} <$story> 预检通过"
echo "=========================================="
echo ""
echo "  目标文档      : $target_doc"
echo "  Status        : $status (信息性,不影响 lightme 行为)"
echo "  Upstream_SHA1 : $sha1"
if [[ "$target" == "design" ]]; then
echo "  Domain 文档数 : $domain_count (in $domain_dir/)"
fi
echo ""
echo "  预检完成,AI 将继续执行 lightme 拷问。"
if [[ "$target" == "pm" ]]; then
echo "  输出文件:iLink-doc/$story/${story}-lightme-pm.md"
else
echo "  输出文件:iLink-doc/$story/${story}-lightme-design.md"
fi
echo ""
echo "  友情提示:lightme 不触碰 master doc / project-context / domain-knowledge。"
echo "  所有 TO-FIX 项以 copy-ready 修订建议代码块形式写入报告,使用者自行复制粘贴。"
echo "  全新 Codex 会话更利于对抗 AI 自身合理性,但可能消耗更多 token;"
echo "  同会话也可继续,隔离效果会下降(见 Root Spec §4.8.3)。"
echo ""
