#!/usr/bin/env bash
set -euo pipefail

# ilink-bootstrap - Prepare Bootstrap execution for Qoder CLI
# This script does pre-checks and outputs guidance for the Bootstrap process

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$DIR/_common.sh"

log_info "iLink Bootstrap - Project Initialization"
echo ""

# Step 1: Check iLink framework files
log_info "Step 1: Checking iLink framework files..."

framework_files=(
  "iLink/iLink-root-spec.md"
  "iLink/souls/universal.soul.md"
  "iLink/souls/pm.soul.md"
  "iLink/souls/design.soul.md"
  "iLink/souls/coder.soul.md"
  "iLink/souls/qa.soul.md"
  "iLink/souls/domain.soul.md"
  "iLink/souls/coach.soul.md"
  "iLink/souls/lightme.soul.md"
)

missing_framework=0
for f in "${framework_files[@]}"; do
  if [[ ! -f "$f" ]]; then
    log_error "Missing: $f"
    missing_framework=1
  else
    echo "  ✅ $f"
  fi
done

if [[ $missing_framework -eq 1 ]]; then
  echo ""
  log_error "iLink framework files are missing."
  echo "Please copy the iLink framework to your project first."
  exit 1
fi

# Step 2: Check Qoder command files
log_info "Step 2: Checking Qoder command files..."

command_files=(
  "ilink-init"
  "ilink-pm"
  "ilink-design"
  "ilink-coder"
  "ilink-qa"
  "ilink-refine"
  "ilink-approve"
  "ilink-status"
  "ilink-domain"
  "ilink-pull"
  "ilink-lightme"
  "ilink-bootstrap"
)

missing_commands=0
for f in "${command_files[@]}"; do
  if [[ ! -f "$DIR/$f" ]]; then
    echo "  ⚠️ Missing: .qoder/commands/$f"
    missing_commands=1
  else
    echo "  ✅ .qoder/commands/$f"
  fi
done

if [[ $missing_commands -eq 1 ]]; then
  echo ""
  log_warn "Some command files are missing. Bootstrap will continue but some features may not work."
fi

# Step 3: Initialize Soul plug system (v1.8.0+)
# See Root Spec §4.7 and Implementation Guide §1.5
log_info "Step 3: Initializing Soul plug system..."

plugs_dir="iLink/souls/plugs"
mkdir -p "$plugs_dir"

write_empty_plug() {
  local role="$1"
  local label="$2"
  local target="$plugs_dir/${role}.project.plug.md"

  if [[ -f "$target" ]]; then
    echo "  ✅ $target (already exists, not overwritten)"
    return 0
  fi

  cat > "$target" <<EOF
# ${role}.project.plug.md
# 项目级补充规则（对 iLink/souls/${role}.soul.md 的加法补充）
# 维护方式：Leader 编辑后 commit → 全团队 update 生效
# 框架升级时本文件不动
# 详见 Root Spec §4.7

---

*本文件当前为空模板。在下方按主题分区写入本项目对 ${label} 角色的补充规则。*
*补充规则可以是 ADD / REFINE / TIGHTEN 三类——增加新约束、细化通用规则到本项目口径、*
*加严已有约束。详见 Root Spec §4.7.2。*
EOF
  echo "  🆕 $target (created from template)"
}

write_empty_plug "pm" "PM"
write_empty_plug "design" "Designer"
write_empty_plug "coder" "Coder"
write_empty_plug "qa" "QA"
write_empty_plug "domain" "Domain Engineer"
write_empty_plug "lightme" "Lightme"

# universal.project.plug.md SHALL NOT be created by bootstrap.
# Projects create it ad hoc when cross-role rules are needed (see Root Spec §4.7.5).

# Step 4: Check project-context.md
log_info "Step 4: Checking project-context.md..."
if [[ -f "project-context.md" ]]; then
  echo "  ✅ project-context.md exists"
  echo "     (Bootstrap will skip generation if content is complete)"
else
  echo "  📝 project-context.md not found"
  echo "     (Bootstrap will analyze project and generate it)"
fi

# Step 5: Check entry files
log_info "Step 5: Checking entry files..."

check_entry_file() {
  local file=$1
  local name=$2
  if [[ -f "$file" ]]; then
    if grep -q "iLink 协作协议" "$file" 2>/dev/null; then
      echo "  ✅ $name: already iLink configured (will skip)"
    else
      echo "  ⚠️ $name: non-iLink file (will backup and migrate)"
    fi
  else
    echo "  🆕 $name: not found (will create)"
  fi
}

check_entry_file "CLAUDE.md" "CLAUDE.md"
check_entry_file "AGENTS.md" "AGENTS.md"

# Step 6: Check iLink-doc directory
log_info "Step 6: Checking iLink-doc directory..."
if [[ -d "iLink-doc" ]]; then
  echo "  ✅ iLink-doc/ exists"
else
  echo "  🆕 iLink-doc/ will be created"
fi

echo ""
echo "=========================================="
echo "Bootstrap Pre-check Complete"
echo "=========================================="
echo ""
echo "Now execute in Qoder chat:"
echo ""
echo "  /ilink-bootstrap"
echo ""
echo "The AI will:"
echo "  1. Analyze your project structure"
echo "  2. Generate project-context.md (at repo root)"
echo "  3. Update CLAUDE.md and AGENTS.md as iLink thin routers"
echo "  4. Create iLink-doc/ directory if needed"
echo ""
